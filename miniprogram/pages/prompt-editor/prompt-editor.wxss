.editor-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(52rpx + env(safe-area-inset-bottom));
}

.editor-head {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.save-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #738892;
  font-size: 23rpx;
}

.save-status__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #70a18e;
  box-shadow: 0 0 0 7rpx rgba(112, 161, 142, 0.13);
}

.editor-favorite {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #778b95;
  font-size: 24rpx;
}

.editor-favorite.is-active {
  background: #fff4dc;
  color: #b8791d;
}

.editor-card {
  margin-top: 16rpx;
  padding: 12rpx;
}

.editor-textarea {
  display: block;
  width: 100%;
  height: 590rpx;
  padding: 24rpx;
  color: #123846;
  font-size: 30rpx;
  line-height: 52rpx;
}

.editor-placeholder {
  color: #9baab2;
  font-size: 30rpx;
  line-height: 52rpx;
}

.section-head {
  margin: 42rpx 2rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  margin-right: 16rpx;
  color: #123846;
  font-size: 29rpx;
  font-weight: 650;
}

.section-desc {
  color: #8295ad;
  font-size: 22rpx;
}

.tag-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-create {
  height: 82rpx;
  margin-top: 22rpx;
  padding-left: 24rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #e9eef4;
  border-radius: 22rpx;
  background: #fff;
}

.tag-create input {
  min-width: 0;
  height: 82rpx;
  flex: 1;
  font-size: 26rpx;
}

.tag-create__button {
  width: 126rpx;
  height: 82rpx;
  padding: 0;
  flex: 0 0 126rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  background: #e6f7f5;
  color: #13a8a7;
  font-size: 25rpx;
  font-weight: 600;
  white-space: nowrap;
}

.editor-tip {
  margin-top: 26rpx;
  display: block;
  color: #8b9ba4;
  font-size: 22rpx;
  line-height: 1.6;
}
