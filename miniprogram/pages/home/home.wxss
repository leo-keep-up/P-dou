.home-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.home-heading__eyebrow {
  color: #75909e;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.home-heading__count {
  margin-bottom: 32rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #e6f7f5;
  color: #517386;
  font-size: 22rpx;
}

.search-box {
  height: 92rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid rgba(213, 225, 231, 0.9);
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(42, 74, 89, 0.06);
}

.search-box__icon {
  color: #668492;
  font-size: 38rpx;
  transform: rotate(-20deg);
}

.search-box__input {
  height: 92rpx;
  flex: 1;
  color: #123846;
  font-size: 27rpx;
}

.search-box__placeholder {
  color: #9aa8b0;
}

.search-box__clear {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #edf3f6;
  color: #70838e;
  font-size: 34rpx;
}

.tag-strip {
  width: calc(100% + 56rpx);
  margin: 24rpx -28rpx 0;
}

.tag-strip__inner {
  padding: 0 28rpx;
  display: inline-flex;
  gap: 14rpx;
}

.list-mode {
  width: 240rpx;
  height: 68rpx;
  margin-top: 28rpx;
  padding: 6rpx;
  display: flex;
  border-radius: 21rpx;
  background: #e5edf1;
}

.list-mode__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #728691;
  font-size: 23rpx;
}

.list-mode__item.is-active {
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(45, 77, 91, 0.1);
  color: #087e80;
  font-weight: 650;
}

.list-head {
  margin: 28rpx 2rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #334b58;
  font-size: 27rpx;
  font-weight: 650;
}

.list-head__hint {
  color: #84959e;
  font-size: 20rpx;
  font-weight: 400;
}

.empty-action {
  width: 260rpx;
  margin-top: 38rpx;
}

.undo-bar {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(166rpx + env(safe-area-inset-bottom));
  z-index: 70;
  min-height: 92rpx;
  padding: 17rpx 18rpx 17rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 25rpx;
  background: #294956;
  box-shadow: 0 14rpx 36rpx rgba(32, 59, 70, 0.26);
  color: #fff;
}

.undo-bar__copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.undo-bar__title {
  font-size: 25rpx;
  font-weight: 600;
}

.undo-bar__preview {
  overflow: hidden;
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.undo-bar__action {
  min-width: 94rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #fff;
  color: #315d70;
  font-size: 24rpx;
  font-weight: 650;
}

/* P兜：清爽列表与紧凑品牌栏 */
.home-page { background:#fff; padding-top:16rpx; }
.home-heading { align-items:center; margin-bottom:24rpx; }
.home-brand { display:flex; align-items:center; }
.home-brand__icon { width:80rpx; height:80rpx; margin-right:10rpx; }
.home-brand__p { color:#13a8a7; font-size:46rpx; font-weight:750; }
.home-brand__name { color:#123846; font-size:42rpx; font-weight:650; }
.home-heading__count { margin:0; background:#f3f5f9; color:#8798ac; padding:8rpx 16rpx; }
.search-box { height:76rpx; border:0; border-radius:999rpx; background:#f4f5f9; box-shadow:none; }
.search-box__input { height:76rpx; font-size:26rpx; }
.search-box__placeholder { color:#8b9db5; }
.search-box__icon { width:25rpx; height:25rpx; border:3rpx solid #8b9db5; border-radius:50%; font-size:0; transform:none; position:relative; margin-right:5rpx; }
.search-box__icon::after { content:''; position:absolute; width:12rpx; height:3rpx; background:#8b9db5; right:-9rpx; bottom:-4rpx; transform:rotate(45deg); }
.tag-strip { margin-top:24rpx; margin-bottom:18rpx; }
.tag-strip__inner { align-items:center; gap:12rpx; }
.filter-chip { height:58rpx; padding:0 24rpx; display:flex; align-items:center; justify-content:center; white-space:nowrap; flex-shrink:0; border-radius:999rpx; background:#f3f5f9; color:#35506a; font-size:25rpx; }
.filter-chip.is-selected { background:#13a8a7; color:#fff; font-weight:600; }
.filter-chip--add { width:58rpx; padding:0; font-size:36rpx; }
.copy-hint { display:flex; align-items:center; justify-content:space-between; gap:8rpx; margin:8rpx 0 12rpx; padding:4rpx 8rpx 4rpx 20rpx; background:#edf9f7; border-radius:18rpx; color:#45817f; font-size:23rpx; }
.copy-hint__close { width:72rpx; height:72rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:32rpx; }
