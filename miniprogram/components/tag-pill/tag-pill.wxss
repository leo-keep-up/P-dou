.tag-pill { height:58rpx; padding:0 22rpx; display:inline-flex; align-items:center; justify-content:center; border:1rpx solid transparent; border-radius:999rpx; background:#f3f5f9; color:#35506a; font-size:25rpx; white-space:nowrap; }
.tag-pill.is-selected { background:#13a8a7; color:#fff; }
.tag-pill.is-compact { height:36rpx; max-width:180rpx; padding:0 14rpx; border-radius:12rpx; font-size:22rpx; }
.tag-pill.is-compact text { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.is-compact.tone-0 { background:#e1efff; color:#387bd5; }
.is-compact.tone-1 { background:#ddf7e6; color:#278a58; }
.is-compact.tone-2 { background:#eee6ff; color:#8052c8; }
.is-compact.tone-3 { background:#fff0dc; color:#db7937; }
