.bottom-nav-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 12rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(242, 246, 248, 0), #f2f6f8 24%);
}

.bottom-nav {
  position: relative;
  height: 122rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #d8e3e8;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 36rpx rgba(42, 74, 89, 0.12);
}

.bottom-nav__item {
  height: 110rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #536b78;
  font-size: 23rpx;
  font-weight: 520;
}

.bottom-nav__item.is-active {
  color: #2f6077;
  font-weight: 650;
}

.bottom-nav__icon-box {
  width: 64rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #eef3f5;
  color: #4d6977;
}

.bottom-nav__item.is-active .bottom-nav__icon-box {
  background: #dcebf2;
  color: #2f6077;
}

.tag-icon {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.user-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
}

.user-icon__head {
  position: absolute;
  left: 50%;
  top: 0;
  width: 17rpx;
  height: 17rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  transform: translateX(-50%);
}

.user-icon__body {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 36rpx;
  height: 17rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 22rpx 22rpx 0 0;
  transform: translateX(-50%);
}

.bottom-nav__create-item {
  height: 110rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-nav__create {
  width: 78rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid #eaf1f4;
  border-radius: 27rpx;
  background: #3d718a;
  color: #fff;
  box-shadow: 0 7rpx 18rpx rgba(61, 113, 138, 0.24);
  font-size: 49rpx;
  line-height: 1;
}

.bottom-nav__create:active,
.bottom-nav__icon-box:active {
  transform: scale(.94);
}

/* Floating navigation, matching the home list */
.bottom-nav-wrap { padding-left:22rpx; padding-right:22rpx; background:linear-gradient(180deg,rgba(255,255,255,0),#f8fbfc 65%); }
.bottom-nav { height:116rpx; border-color:#edf1f6; border-radius:34rpx; box-shadow:0 6rpx 26rpx rgba(24,60,83,.08); }
.bottom-nav__item { height:104rpx; color:#60788d; font-size:23rpx; }
.bottom-nav__icon-box { background:#f5f8fa; color:#7890a6; width:58rpx; height:48rpx; border-radius:16rpx; }
.bottom-nav__item.is-active, .bottom-nav__item.is-active .bottom-nav__icon-box { color:#13a8a7; }
.bottom-nav__item.is-active .bottom-nav__icon-box { background:#e6f7f5; }
.bottom-nav__create { width:76rpx; height:76rpx; border:4rpx solid #e6f7f5; border-radius:25rpx; background:#13a8a7; box-shadow:0 5rpx 16rpx rgba(19,168,167,.20); font-weight:300; }
