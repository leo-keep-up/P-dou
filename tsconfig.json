{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "strict": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "allowJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./miniprogram/typings"]
  },
  "include": ["miniprogram/**/*.ts"]
}
